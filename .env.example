# ==============================================================================
# Variáveis de Ambiente — Marcelo Santos Negócios Imobiliários
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# ATENÇÃO: Nunca exponha chaves privadas (como GEMINI_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY ou CRON_SECRET) com o prefixo NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (obrigatório para vitrine pública, auth e painel /admin)
# Encontre em: Project Settings -> API no painel do Supabase
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# Somente servidor — usada no endpoint protegido /api/cron/followup (RPCs SECURITY DEFINER)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-servidor

# ------------------------------------------------------------------------------
# URL Pública do Site (usada para Open Graph, canonical, sitemap.xml e links de follow-up)
# Em desenvolvimento local: http://localhost:3000
# Em produção: https://seudominio.com.br
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Gemini API (somente servidor — usado na Fábrica de Anúncios / Bloco 4)
# Obtenha em: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua-chave-gemini-somente-servidor

# ------------------------------------------------------------------------------
# WhatsApp Comercial / Agente de IA (Fase 2)
# Número do chip dedicado em formato E.164 sem '+' (ex: 5511999999999).
# Se vazio, a vitrine pública utiliza o fallback 5511966332122.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=5511966332122

# ------------------------------------------------------------------------------
# Automação Anti-Esquecimento (Fase 2 — GET /api/cron/followup)
# Token secreto (somente servidor) enviado no header Authorization: Bearer <CRON_SECRET>
# ------------------------------------------------------------------------------
CRON_SECRET=defina-um-segredo-aleatorio-seguro

# ------------------------------------------------------------------------------
# Rastreamento e Conversão (opcional — Fase 2)
# Os scripts só são carregados na vitrine pública quando os IDs estiverem preenchidos
# ------------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
